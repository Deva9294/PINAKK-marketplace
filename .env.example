MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority
PINAKK_ADMIN_EMAIL=admin@example.com
PINAKK_ADMIN_PASSWORD=replace-with-a-long-unique-password
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Online checkout is disabled unless explicitly set to true.
PINAKK_ONLINE_PAYMENTS_ENABLED=false

# Razorpay (required only to enable online checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public checkout key; this is not a secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=
